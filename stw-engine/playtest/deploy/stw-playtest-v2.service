[Unit]
Description=STW canonical HQ native game bridge
After=network.target

[Service]
Type=simple
User=stw-playtest
Group=stw-playtest
WorkingDirectory=/opt/wirrwar/stw-engine
EnvironmentFile=/etc/stw-playtest-v2.env
ExecStart=/usr/bin/xvfb-run -a -s "-screen 0 1280x720x24 +extension GLX +render -noreset" /usr/bin/node /opt/wirrwar/stw-engine/playtest/bridge/server.mjs
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
